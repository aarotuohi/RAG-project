# ─────────────────────────────────────────────────────────────────────────────
AISALES — Environment variables (Ollama edition)
Copy this file to .env if you need to override defaults.
# ─────────────────────────────────────────────────────────────────────────────

# Optional — Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional — LLM model (default: auto-selected based on VRAM)
# Examples: qwen2.5:7b-instruct-q4_K_M, qwen2.5:14b-instruct-q4_K_M, llama3.3:70b-instruct-q4_K_M
# OLLAMA_LLM_MODEL=qwen2.5:14b

# Optional — Embedding model (default: nomic-embed-text)
# OLLAMA_EMBED_MODEL=nomic-embed-text
