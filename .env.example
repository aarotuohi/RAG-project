# ─────────────────────────────────────────────────────────────────────────────
# AISALES — Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required — your OpenAI secret key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk...

# Optional — chat model to use (default: gpt-4o-mini)
# Recommended options: gpt-4o-mini, gpt-4o, gpt-4-turbo
OPENAI_LLM_MODEL=gpt-4o-mini

# Optional — embedding model to use (default: text-embedding-3-small)
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
OPENAI_EMBED_MODEL=text-embedding-3-small
